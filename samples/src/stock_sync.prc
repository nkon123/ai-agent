CREATE OR REPLACE PROCEDURE STOCK_SYNC IS
  -- 데모용 가짜 소스. WMS 에서 받은 재고(인터페이스 IF_STK_RECV)를 재고 마스터에 반영한다.
BEGIN
  MERGE INTO STK_MST M
  USING (SELECT ITEM_CD, WH_CD, STOCK_QTY
           FROM IF_STOCK_TMP
          WHERE PROC_YN = 'N') S
     ON (M.ITEM_CD = S.ITEM_CD AND M.WH_CD = S.WH_CD)
   WHEN MATCHED THEN UPDATE SET M.STOCK_QTY = S.STOCK_QTY
   WHEN NOT MATCHED THEN INSERT (ITEM_CD, WH_CD, STOCK_QTY)
                         VALUES (S.ITEM_CD, S.WH_CD, S.STOCK_QTY);

  UPDATE IF_STOCK_TMP
     SET PROC_YN = 'Y'
   WHERE PROC_YN = 'N';
END;
/
